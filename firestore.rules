rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isValidAuthor(author) {
      return author in ['Tanvi', 'Saie'];
    }

    function isValidStatus(status) {
      return status in ['in-progress', 'review', 'completed', 'idea'];
    }

    function isValidPriority(priority) {
      return priority in ['high', 'medium', 'low'];
    }

    // ===============================================================
    // Projects Collection (Shared Workspace Metadata)
    // ===============================================================
    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.resource.data.title is string &&
                      request.resource.data.title.size() > 0 &&
                      request.resource.data.title.size() <= 120;
    }

    // ===============================================================
    // Notes Collection (Collaborative Notes, Tasks & Comments)
    // ===============================================================
    match /notes/{noteId} {
      // Allow reading notes
      allow read: if true;

      // Allow creating a note with valid schema and attributed to Tanvi or Saie
      allow create: if request.resource.data.title is string &&
                       request.resource.data.title.size() > 0 &&
                       request.resource.data.title.size() <= 150 &&
                       request.resource.data.content is string &&
                       request.resource.data.content.size() <= 15000 &&
                       isValidAuthor(request.resource.data.author) &&
                       isValidStatus(request.resource.data.status) &&
                       isValidPriority(request.resource.data.priority);

      // Allow updates (editing notes, checking tasks, adding comments, reacting)
      allow update: if request.resource.data.title is string &&
                       request.resource.data.title.size() > 0 &&
                       request.resource.data.content is string &&
                       isValidStatus(request.resource.data.status) &&
                       isValidPriority(request.resource.data.priority);

      // Allow deleting notes
      allow delete: if true;
    }

    // ===============================================================
    // Activities Collection (Team Audit Timeline)
    // ===============================================================
    match /activities/{activityId} {
      allow read: if true;
      allow create: if isValidAuthor(request.resource.data.user) &&
                       request.resource.data.text is string &&
                       request.resource.data.text.size() <= 300;
      allow delete: if true;
    }

    // Deny all other unmatched paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
